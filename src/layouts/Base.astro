---
import { Font } from "astro:assets"
import Image from "astro/components/Image.astro"
import Header from "@/lib/components/header.astro"
import Footer from "@/lib/components/footer.astro"
import ParkImage from "@/lib/assets/images/park.png"
import "../styles/global.css"
---

<html>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-mono" preload />
  </head>
  <body class="font-sans bg-bg text-fg leading-loose">
    <Header />

    <div class="w-2xl mx-auto mt-8">
      <Image src={ParkImage} alt="" />
    </div>

    <main class="w-2xl mx-auto flex flex-col gap-8 mt-8">
      <slot />
    </main>

    <Footer />
  </body>
</html>
